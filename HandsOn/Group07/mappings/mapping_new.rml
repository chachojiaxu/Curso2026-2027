<#ParkMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "../csv/200761-0-parques-jardines-updated-csv.csv" ;
        rml:referenceFormulation ql:CSV 
    ];  
      rr:subjectMap [
        rr:template "http://www.madridurbanenvironment.org/resource/park/{PK}" ;
        rr:termType rr:IRI ;
        rr:class ue:Park
    ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:identifier ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "PK" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
        rr:predicateMap [rr:constant rdfs:label; rr:termType rr:IRI] ;
        rr:objectMap [ rr:template "{NOMBRE}" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:name ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "NOMBRE" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:description ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "DESCRIPCION-ENTIDAD" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:schedule ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "HORARIO" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:accessibilityLevel ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "ACCESIBILIDAD" ; rr:termType rr:Literal;
                            rr:datatype xsd:integer ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:webPage ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "CONTENT-URL" ; rr:termType rr:Literal;
                            rr:datatype xsd:anyURI ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:streetName ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "NOMBRE-VIA" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
                            ];
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:streetType ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "CLASE-VIAL" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:locality ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "LOCALIDAD" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:province ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "PROVINCIA" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:postalCode ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "CODIGO-POSTAL" ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:code ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "COD-BARRIO"  ; rr:termType rr:Literal;
                            rr:datatype xsd:integer ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:Neighborhood ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "BARRIO"  ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:districtCode ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "COD-DISTRITO"  ; rr:termType rr:Literal;
                            rr:datatype xsd:integer ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:District ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "DISTRITO"  ; rr:termType rr:Literal;
                            rr:datatype xsd:string ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:utmX ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "COORDENADA-X" ; rr:termType rr:Literal;
                            rr:datatype xsd:decimal ]
                            ] ;
    rr:predicateObjectMap [
                            rr:predicateMap [ rr:constant ue:utmY ; rr:termType rr:IRI ] ;
                            rr:objectMap [ rml:reference "COORDENADA-Y" ; rr:termType rr:Literal;
                            rr:datatype xsd:decimal ]
                            ] ;
.