PREFIX ue:   <http://www.madridurbanenvironment.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# Query 1: Numero de individuos por clase.
SELECT ?class (COUNT(?s) AS ?n) 
WHERE { 
    ?s a ?class 
} 
GROUP BY ?class 
ORDER BY DESC(?n)
;

# Query 2: Fuentes de beber operativas para mascotas y su calle.
SELECT ?label ?status ?use ?streetName 
WHERE {
    ?f a ue:DrinkingFountain ; 
       rdfs:label ?label ; 
       ue:status ?status ; 
       ue:intendedUse ?use ; 
       ue:streetName ?streetName .
    FILTER(?status = "OPERATIVO" && CONTAINS(?use, "MASCOTAS"))
} 
LIMIT 20
;

# Query 3: Fuentes por distrito.
SELECT ?district (COUNT(?f) AS ?fountains) 
WHERE {
    ?f a ue:DrinkingFountain ; 
       ue:District ?district .
} 
GROUP BY ?district 
ORDER BY DESC(?fountains)
;

# Query 4 Barrios del distrito 15 (Ciudad Lineal)
SELECT DISTINCT ?neighborhood ?code 
WHERE {
    ?b a ue:Bench ; 
       ue:Neighborhood ?neighborhood ; 
       ue:code ?code ; 
       ue:districtCode 15 .
} 
ORDER BY ?code
;

# Query 5: Parques con nivel de accesibilidad y pagina web.
SELECT ?name ?level ?web 
WHERE {
    ?p a ue:Park ; 
       rdfs:label ?name ; 
       ue:accessibilityLevel ?level ; 
       ue:webPage ?web .
} 
ORDER BY DESC(?level) 
LIMIT 20
;

# Query 6: Aseos publicos de un distrito, enlazados mediante el nombre del distrito.
SELECT ?toilet ?district 
WHERE {
    ?t a ue:PublicToilet ; 
       rdfs:label ?toilet ; 
       ue:District ?district .
} 
LIMIT 20
;

# Query 7: Numero de bancos operativos por distrito.
SELECT ?district (COUNT(?b) AS ?benches) 
WHERE {
    ?b a ue:Bench ; 
       ue:status "OPERATIVO" ; 
       ue:District ?district .
} 
GROUP BY ?district 
ORDER BY DESC(?benches)
;

# Query 8 Comprueba que las coordenadas existentes sean xsd:decimal
SELECT ?s ?v 
WHERE { 
    { ?s ue:utmX ?v } UNION { ?s ue:utmY ?v } 
    FILTER(datatype(?v) != xsd:decimal) 
}
;

# Query 9: Valores de texto sin recortar o con espacios repetidos.
SELECT ?s ?p ?v 
WHERE { 
    ?s ?p ?v . 
    FILTER(isLiteral(?v) && REGEX(STR(?v), "^\\s|\\s$|\\s{2,}")) 
} 
LIMIT 20