PREFIX cls:  <https://group10.org/air-quality-2026/ontology/classes/>
PREFIX prop: <https://group10.org/air-quality-2026/ontology/properties/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>


# Q1. Every station with the municipality where it is located

SELECT ?station ?stationLabel ?municipalityCode
WHERE {
  ?station a cls:Station;
  rdfs:label ?stationLabel;
  prop:locatedIn ?municipality .
  ?municipality prop:hasMunicipalityCode ?municipalityCode .
}
ORDER BY ?municipalityCode


# Q2. Hourly values of measurement type 83 at station 28102001 on 1 January 2026

SELECT ?hour ?value
WHERE {
  ?obs a cls:Observation;
  prop:hasSamplePoint ?sp;
  prop:hasMonth 1;
  prop:hasDay 1;
  prop:hasHour ?hour;
  prop:hasValue ?value .
  ?sp prop:hasStation ?station;
  prop:hasMeasurementType ?type .
  ?station prop:hasStationCode 1;
  prop:locatedIn ?municipality .
  ?municipality prop:hasMunicipalityCode "28102" .
  ?type prop:hasMeasurementCode 83 .
}
ORDER BY ?hour


# Q3. Average, minimum and maximum value per measurement type and month

SELECT ?measurementCode ?month (AVG(?value) AS ?avg) (MIN(?value) AS ?min) (MAX(?value) AS ?max)
WHERE {
  ?obs prop:hasSamplePoint ?sp;
  prop:hasMonth ?month;
  prop:hasValue ?value .
  ?sp prop:hasMeasurementType ?type .
  ?type prop:hasMeasurementCode ?measurementCode .
}
GROUP BY ?measurementCode ?month
ORDER BY ?measurementCode ?month


# Q4. Check that every observation has a value and a sample point (the three numbers must be equal)

SELECT (COUNT(?obs) AS ?observations) (COUNT(?value) AS ?withValue) (COUNT(?sp) AS ?withSamplePoint)
WHERE {
  ?obs a cls:Observation .
  OPTIONAL { ?obs prop:hasValue ?value }
  OPTIONAL { ?obs prop:hasSamplePoint ?sp }
}
